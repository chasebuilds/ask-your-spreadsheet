    "test": "vitest run",
    "smoke": "playwright test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "papaparse": "^5.7.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
